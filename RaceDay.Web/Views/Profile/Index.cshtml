@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="page-head">
    <h1>My profile</h1>
    <p>Update your details and profile picture.</p>
    <div class="head-rule"></div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Your profile picture" class="avatar avatar-lg mb-3" id="avatar-preview" />
            }
            else
            {
                <span class="avatar avatar-lg avatar-initials mb-3" id="avatar-initials" aria-hidden="true">@Display.Initials(Model.FullName)</span>
                <img alt="Preview of your new picture" class="avatar avatar-lg mb-3 d-none" id="avatar-preview" />
            }

            <h2 class="h3 mb-1">@Model.FullName</h2>
            <p class="text-muted mb-1">@Model.Role</p>
            @if (Model.MemberSince.Year > 1)
            {
                <p class="text-muted small mb-3">Member since @Model.MemberSince.ToString("MMM yyyy")</p>
            }

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start">
                <label for="picture" class="form-label">Profile picture</label>
                <input id="picture" name="picture" type="file" class="form-control mb-2"
                       accept="image/png,image/jpeg,image/webp" data-preview="#avatar-preview" data-preview-hide="#avatar-initials" required />
                <div class="form-text mb-3">JPG, PNG or WEBP, up to 5 MB.</div>
                <button type="submit" class="btn btn-dark w-100">Upload picture</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card">
            <h2>Personal information</h2>
            <form asp-action="Update" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
