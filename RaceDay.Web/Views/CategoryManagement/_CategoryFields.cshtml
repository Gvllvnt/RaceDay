@model CategoryFormViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. Open Men 10 km" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="row g-3 mb-3">
    <div class="col-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
    <div class="col-6">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" type="time" class="form-control"
               value="@(Model.StartTime.HasValue ? Model.StartTime.Value.ToString("HH:mm") : string.Empty)" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-6">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="text-danger"></span>
    </div>
    <div class="col-6">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" type="number" step="1" min="1" class="form-control" />
        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
    </div>
</div>
