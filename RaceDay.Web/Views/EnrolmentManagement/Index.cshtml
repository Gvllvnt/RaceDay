@model EnrolmentManagementViewModel
@{
    ViewData["Title"] = "Enrolments - " + Model.Event.Title;
    var evt = Model.Event;
}

<div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Enrolments</h1>
        <p>@evt.Title &middot; @Display.Date(evt.EventDate)</p>
        <div class="head-rule"></div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="EventManagement" asp-action="Index">My events</a>
        <a class="btn btn-primary" asp-controller="ResultManagement" asp-action="Index" asp-route-eventId="@evt.EventId">Capture results</a>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-end">
        <input type="hidden" name="eventId" value="@evt.EventId" />
        <div>
            <label for="category" class="form-label">Filter by category</label>
            <select id="category" name="category" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@string.IsNullOrEmpty(Model.CategoryFilter)">All categories</option>
                @foreach (var name in Model.CategoryNames)
                {
                    <option value="@name" selected="@(Model.CategoryFilter == name)">@name</option>
                }
            </select>
        </div>
        <noscript><button type="submit" class="btn btn-dark">Apply</button></noscript>
    </form>
    <partial name="_StatusLegend" />
</div>

@if (!Model.Enrolments.Any())
{
    <div class="rd-card empty-state">
        <i class="bi bi-people"></i>
        <p class="mb-0">@(string.IsNullOrEmpty(Model.CategoryFilter) ? "Nobody has enrolled yet." : "Nobody is enrolled in that category.")</p>
    </div>
}
else
{
    <div class="rd-card rd-card-flush">
        <div class="rd-card-head"><h2>@Model.Enrolments.Count @(Model.Enrolments.Count == 1 ? "participant" : "participants")</h2></div>
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr>
                        <th scope="col">Race no.</th>
                        <th scope="col">Participant</th>
                        <th scope="col">Category</th>
                        <th scope="col">Enrolled</th>
                        <th scope="col">Status</th>
                        <th scope="col">Change status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td>
                                @if (e.RaceNumber.HasValue)
                                {
                                    <span class="race-no">@e.RaceNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <th scope="row">@e.Participant<br /><span class="text-muted fw-normal">@e.ParticipantEmail</span></th>
                            <td>@e.Category</td>
                            <td>@e.EnrolledAt.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="@e.Status" /></td>
                            <td>
                                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <input type="hidden" name="eventId" value="@evt.EventId" />
                                    <input type="hidden" name="category" value="@Model.CategoryFilter" />
                                    <select name="status" class="form-select form-select-sm" aria-label="Status for @e.Participant">
                                        @foreach (var status in EnrolmentManagementViewModel.Statuses)
                                        {
                                            <option value="@status" selected="@(status == e.Status)">@status</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-dark btn-sm">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
