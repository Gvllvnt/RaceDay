@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="rd-card empty-state mx-auto" style="max-width: 560px;">
    <i class="bi bi-signpost-split"></i>
    @if (Model.StatusCode.HasValue)
    {
        <p class="display-title h1 mb-1">@Model.StatusCode</p>
    }
    <h1 class="h2">@Model.Title</h1>
    <p>@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to RaceDay</a>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small mt-3 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>
