@if (TempData["Success"] is string success && !string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show rd-alert" role="status">
        <i class="bi bi-check-circle-fill me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error && !string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
