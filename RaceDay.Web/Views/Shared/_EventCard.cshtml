@model EventSummary
<article class="event-card">
    <a class="event-card-banner" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <img src="@Model.BannerUrl" alt="" loading="lazy" />
        }
        else
        {
            <div class="banner-fallback type-@(Model.EventType ?? "event")"><i class="bi @Display.EventTypeIcon(Model.EventType)"></i></div>
        }
        <div class="bib">
            <span class="bib-day">@Model.EventDate.ToString("dd")</span>
            <span class="bib-month">@Model.EventDate.ToString("MMM")</span>
        </div>
    </a>
    <div class="event-card-body">
        <h3 class="event-card-title">
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.Title</a>
        </h3>
        <p class="event-meta"><i class="bi bi-geo-alt-fill"></i>@Model.Location</p>
        <div class="chip-row">
            <span class="chip chip-type"><i class="bi @Display.EventTypeIcon(Model.EventType)"></i>@Display.EventTypeLabel(Model.EventType)</span>
            @if (Model.Distance.HasValue)
            {
                <span class="chip">@Display.Distance(Model.Distance)</span>
            }
            <span class="chip">@Model.CategoryCount @(Model.CategoryCount == 1 ? "category" : "categories")</span>
        </div>
    </div>
    <div class="event-card-foot">
        <span>@Display.Date(Model.EventDate)</span>
        <a class="btn btn-primary btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event</a>
    </div>
</article>
