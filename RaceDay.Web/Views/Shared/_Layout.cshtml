@{
    var user = Context.Session.GetUser();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(params string[] names) =>
        names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

    <header>
        <nav class="navbar navbar-expand-lg rd-nav" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-chevron-double-right"></i>RACEDAY
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (user == null)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index">Events</a></li>
                        }
                        else if (user.IsOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("EventManagement", "CategoryManagement", "EnrolmentManagement", "ResultManagement")" asp-controller="EventManagement" asp-action="Index">My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="EventManagement" asp-action="Create">New Event</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index">Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Enrolments")" asp-controller="Enrolments" asp-action="Index">My Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Results")" asp-controller="Results" asp-action="Index">My Results</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (user == null)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Join RaceDay</a></li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" alt="" class="avatar avatar-sm" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-sm avatar-initials" aria-hidden="true">@Display.Initials(user.FullName)</span>
                                    }
                                    <span>@user.FullName</span>
                                    <span class="role-pill">@user.Role</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>My profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        <div class="road-line" aria-hidden="true"></div>
    </header>

    <main id="main" class="container py-4 py-lg-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span class="rd-brand rd-brand-sm"><i class="bi bi-chevron-double-right"></i>RACEDAY</span>
            <span>Road running, walking and cycling events across South Africa. &copy; 2026 RaceDay.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
